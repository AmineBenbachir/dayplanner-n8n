    {
      "parameters": {
        "jsCode": "// English search first; French search only if the English one found nothing\nconst en = $('Geocode').first().json.results;\nconst g = (en && en.length) ? en[0] : $('Geocode FR').first().json.results[0];\nconst d = $input.first().json.daily;\n// 0 = today, 1 = tomorrow\nconst day = Number($('When Executed by Another Workflow').first().json.day) === 1 ? 1 : 0;\nreturn [{ json: {\n  status: 'ok',\n  city: g.name,\n  country: g.country,\n  lat: g.latitude,\n  lon: g.longitude,\n  day,\n  date: d.time[day],\n  tmax: d.temperature_2m_max[day],\n  rain_prob: d.precipitation_probability_max[day] ?? 0\n}}];"
      },
