      "parameters": {
        "jsCode": "const req = $('Read city').first().json;\nconst c = $input.first().json;\nlet weather;\nif (req.flag) {\n  weather = req.flag;\n  c.rain_prob = weather === 'rain' ? 80 : c.rain_prob;\n  c.tmax = weather === 'heat' ? 35 : c.tmax;\n}\nelse if (c.rain_prob >= 50) weather = 'rain';\nelse if (c.tmax >= 32) weather = 'heat';\nelse weather = 'fair';\nreturn [{ json: { ...c, chat_id: req.chat_id, weather } }];"
      },
