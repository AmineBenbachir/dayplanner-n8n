      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst words = (msg.text || '').trim().split(/\\s+/);\nconst command = words[0].toLowerCase();\nconst parts = words.slice(1);\nconst flags = ['rain', 'fair', 'heat'];\nlet flag = null;\nif (parts.length && flags.includes(parts[parts.length - 1].toLowerCase())) {\n  flag = parts.pop().toLowerCase();\n}\nconst day = command.startsWith('/tomorrow') ? 1 : 0;\nreturn [{ json: { chat_id: msg.chat.id, city: parts.join(' '), flag, day } }];"
      },
