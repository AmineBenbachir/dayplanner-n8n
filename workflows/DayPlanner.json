        "jsCode": "const ctx = $('Filter & rank').last().json;\nconst list = ctx.places.slice(0, 8).map(p => '- ' + p.name).join('\\n');\nreturn [{ json: {\n  text: `Today in ${ctx.city} (${ctx.weather}, max ${ctx.tmax}°C). Suggested places:\\n${list}`,\n  status: 'fallback'\n}}];"
      },
      "id": "a4eb34fc-4025-40c0-8014-22ccbcb92a5b",
      "name": "Fallback plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1424,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Filter & rank').last().json;\nlet raw = String($input.first().json.text || '');\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst icons = {\n  weather: { rain: '\\u{1F327}\\u{FE0F}', heat: '\\u{1F321}\\u{FE0F}', fair: '\\u{1F324}\\u{FE0F}' }[ctx.weather] || '\\u{1F324}\\u{FE0F}',\n  morning: '\\u{1F305}',\n  afternoon: '\\u{2600}\\u{FE0F}',\n  evening: '\\u{1F319}',\n  tip: '\\u{1F4A1}'\n};\nconst header = w => `\\n<b>${icons[w]} ${w[0].toUpperCase() + w.slice(1)}</b>`;\nconst wordOf = line => line.replace(/<[^>]*>/g, '').replace(/[^A-Za-z]/g, '').toLowerCase();\n\n// Remove any reasoning written before the plan: keep from the LAST \"Weather\" title line\nraw = raw.replace(/<think>[\\s\\S]*?<\\/think>/gi, '');\nlet rawLines = raw.split('\\n');\nlet start = -1;\nrawLines.forEach((l, i) => {\n  if (wordOf(l) === 'weather' || /^[^A-Za-z]*weather\\s*:/i.test(l.trim())) start = i;\n});\nif (start > 0) rawLines = rawLines.slice(start);\n\n// Title: \"Your day in Paris\" + \"Today/Tomorrow, Friday 23 October\"\nconst when = ctx.day == 1 ? 'Tomorrow' : 'Today';\nconst dateTxt = ctx.date ? new Date(ctx.date + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }) : '';\nconst title = `<b>\\u{1F4CD} Your day in ${esc(ctx.city)}</b>\\n<i>${when}${dateTxt ? ', ' + dateTxt : ''}</i>`;\n\nlet found = 0;\nconst lines = rawLines.map(line => {\n  const clean = line.replace(/<[^>]*>/g, '').replace(/[*#_]/g, '').trim();\n  const word = wordOf(clean).replace(/^tips$/, 'tip');\n  if (icons[word]) { found++; return header(word); }\n  const m = clean.match(/^[^A-Za-z]*(weather|morning|afternoon|evening|tips?)\\s*:\\s*(.+)$/i);\n  if (m) { const w = m[1].toLowerCase().replace(/^tips$/, 'tip'); found++; return header(w) + '\\n' + esc(m[2]); }\n  return esc(clean);\n});\n\nlet plan = title + '\\n\\n' + lines.join('\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\nlet status = 'ok';\n\n// Fallback if the AI answer is broken, too short or too long for Telegram (4096 max)\nif (found < 4 || plan.length < 250 || plan.length > 3800) {\n  const label = { rain: 'Rainy day, favour indoor visits', heat: 'Hot day, stay indoors at midday', fair: 'Nice weather, enjoy the outdoors' }[ctx.weather] || 'Plan';\n  // Pick places type by type (one museum, one landmark, one park...), no religious place, 6 max\n  const pool = (ctx.places || []).filter(p => p.type !== 'religion');\n  const byType = {};\n  pool.forEach(p => { (byType[p.type] = byType[p.type] || []).push(p); });\n  const groups = Object.values(byType);\n  const picked = [];\n  for (let round = 0; picked.length < 6 && groups.some(g => g.length > round); round++) {\n    for (const g of groups) { if (g[round] && picked.length < 6) picked.push(g[round]); }\n  }\n  const list = picked.map(p => '• ' + esc(p.name)).join('\\n') || 'No places found nearby.';\n  plan = `${title}\\n\\n${label}, up to ${ctx.tmax}°C.\\nOur AI guide is busy right now, so here are the top places to visit today:\\n\\n<b>Suggested places</b>\\n${list}`;\n  status = 'fallback';\n}\n\nreturn [{ json: {\n  timestamp: new Date().toISOString(),\n  chat_id: ctx.chat_id,\n  city: ctx.city,\n  country: ctx.country,\n  weather: ctx.weather,\n  tmax: ctx.tmax,\n  rain_prob: ctx.rain_prob,\n  places_count: ctx.count,\n  plan,\n  status\n} }];"
      },
      "id": "7d983913-46eb-4fde-8f7c-0de47f224670",
      "name": "Final reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
