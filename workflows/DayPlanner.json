    {
      "parameters": {
        "jsCode": "const ctx = $('Prepare request').last().json;\nconst banned = ['foods', 'accomodations', 'banks', 'transport', 'industrial_facilities', 'burial_places'];\nconst groups = ['museums', 'theatres_and_entertainments', 'malls', 'amusements', 'natural', 'architecture', 'historic', 'cultural', 'urban_environment'];\n// Religious places detected by category OR by name\nconst relRe = /church|cathedral|mosque|synagogue|chapel|basilica|temple|abbey|monastery|shrine|jewish|eglise|église|cathédrale|mosquée|notre[- ]dame|zaouia/i;\nconst caps = { religion: 1 };   // only 1 religious candidate\nconst defaultCap = 4;           // 4 places maximum per other type\nconst seen = new Set();\nconst count = {};\n\nconst sorted = $input.all().map(i => i.json)\n  .filter(p => p.name && p.name.trim().length > 3)\n  .filter(p => !/^\\d/.test(p.name))\n  .filter(p => {\n    const k = p.kinds || '';\n    if (banned.some(b => k.includes(b))) return false;\n    if (k.includes('shops') && !k.includes('malls')) return false;\n    return true;\n  })\n  .filter(p => { const k = p.name.toLowerCase(); if (seen.has(k)) return false; seen.add(k); return true; })\n  .sort((a, b) => ((Number(b.rate) || 0) - (Number(a.rate) || 0)) || ((b.wikidata ? 1 : 0) - (a.wikidata ? 1 : 0)));\n\nconst places = [];\nfor (const p of sorted) {\n  const k = p.kinds || '';\n  const g = (k.includes('religion') || relRe.test(p.name)) ? 'religion' : (groups.find(x => k.includes(x)) || 'other');\n  const cap = caps[g] ?? defaultCap;\n  if ((count[g] || 0) >= cap) continue;\n  count[g] = (count[g] || 0) + 1;\n  places.push({ name: p.name, type: g.replace(/_/g, ' ') });\n  if (places.length >= 20) break;\n}\n\nreturn [{ json: { ...ctx, places, count: places.length } }];"
      },
