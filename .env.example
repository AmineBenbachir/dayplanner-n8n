# Copy this file to .env and fill in your own values. Never commit the real .env.

# Postgres database (used by n8n and for the request log)
POSTGRES_USER=dayplanner
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dayplanner

# n8n
# Encrypts the credentials stored in n8n. Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Public HTTPS address of n8n, needed for the Telegram trigger (e.g. a cloudflared or ngrok tunnel)
WEBHOOK_URL=https://your-tunnel-url/
GENERIC_TIMEZONE=Europe/Paris

# API keys: not read by Docker, they are entered as n8n credentials in the editor
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENTRIPMAP_API_KEY=
